# ClusterAudienceKit environment variables
#
# HONESTY NOTE: as of this release, NO environment variable is actually read
# by any code path in this repository. The two variables below
# (CLUSTERAUDIENCEKIT_LOG_LEVEL / CLUSTERAUDIENCEKIT_LOG_FILE) were
# previously read by a Python module (`src/clusteraudiencekit/`) that turned
# out to be a stale, unused duplicate of the real package (see repo hygiene
# notes in docs/ROADMAP_HONEST.md) and has since been removed; the `log`
# crate is a declared-but-not-yet-used Rust dependency with no
# `env_logger`/equivalent initialization wired up yet. Both are listed here
# as RESERVED — the intended shape once logging is actually wired — rather
# than removed outright, since re-adding real logging support is a small,
# reasonable near-term addition and this documents the intended variable
# names for that work. Every other variable previously in this file (API
# keys, database credentials, encryption keys, Redis/Elasticsearch URLs,
# etc.) described a server/database/secrets-management product surface that
# doesn't exist in this package at all (it's a library, not a service) and
# has been removed rather than left as a misleading checklist.

# RESERVED (not yet wired to any code): intended logging verbosity once a
# logging backend (e.g. env_logger) is added. One of: error, warn, info,
# debug, trace.
CLUSTERAUDIENCEKIT_LOG_LEVEL=info

# RESERVED (not yet wired to any code): intended log output file path once
# a logging backend is added. If unset, would default to stderr.
CLUSTERAUDIENCEKIT_LOG_FILE=
